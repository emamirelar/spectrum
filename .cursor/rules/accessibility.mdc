## Common Accessibility Patterns

### Loading States
```typescript
// ✅ Accessible loading pattern
render() {
  return (
    <button 
      aria-busy={this.loading}
      aria-label={this.loading ? 'Loading...' : this.label}
      disabled={this.loading || this.disabled}>
      {this.loading && <span aria-hidden="true">⏳</span>}
      {this.label}
    </button>
  );
}
```

### Error States
```typescript
// ✅ Accessible error pattern
render() {
  const errorId = `error-${this.componentId}`;
  
  return (
    <div>
      <input
        aria-invalid={this.hasError}
        aria-describedby={this.hasError ? errorId : undefined}
      />
      {this.hasError && (
        <div id={errorId} role="alert" aria-live="assertive">
          {this.errorMessage}
        </div>
      )}
    </div>
  );
}
```

### Dynamic Content
```typescript
// ✅ Accessible dynamic content updates
@Watch('items')
onItemsChange() {
  const count = this.items.length;
  this.announceToScreenReader(`${count} items available`);
}
```

