{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@types/node": "^22.9.1"
  },
  "devDependencies": {
    "@storybook/test-runner": "^0.23.0",
    "lerna": "^8.1.9",
    "npm-check-updates": "^17.1.11",
    "playwright": "^1.58.0",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "test": "npx lerna run test",
    "update": "npx npm-check-updates -u",
    "zip": "cd .. && tar -a -c -f stencil-storybook-boilerplate.zip --exclude \"node_modules\" stencil-storybook-boilerplate",
    "build:core": "cd packages/core && npm run build",
    "pack:core": "cd packages/core && npm pack",
    "build:pack": "npm run build:core && npm run pack:core",
    "link:core": "cd packages/core && npm link",
    "clean": "rm -rf packages/core/dist packages/core/*.tgz",
    "rebuild": "npm run clean && npm run build:pack"
  }
}
