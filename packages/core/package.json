{
  "name": "@unops-itg-npm/cpit-spectrum",
  "version": "0.0.1-alpha.26",
  "description": "Spectrum, UNOPS Design System Core Components",
  "author": "Justin Waugh <justinwa@unops.org>",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.js",
  "es2017": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/core/core.esm.js",
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build --docs",
    "prepare": "npm run build",
    "start": "stencil build --docs --watch",
    "test": "npm run test.spec && npm run test.e2e",
    "test.spec": "stencil test --spec",
    "test.e2e": "playwright test",
    "generate": "stencil generate",
    "update": "npx npm-check-updates -u",
    "preview": "npx http-server www"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@stencil/angular-output-target": "^0.10.0",
    "@stencil/core": "^4.22.2",
    "@stencil/playwright": "^0.2.1",
    "@stencil/react-output-target": "^0.7.4",
    "@stencil/sass": "^3.0.12",
    "@stencil/vue-output-target": "^0.9.0",
    "@types/jest": "^29.5.14",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "stencil-tailwind-plugin": "^1.8.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "license": "MIT",
  "dependencies": {
    "@glidejs/glide": "^3.7.1",
    "@material/material-color-utilities": "^0.3.0"
  }
