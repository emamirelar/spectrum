{
  "name": "@spectrum/storybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "storybook.run": "storybook dev -p 6006",
    "storybook": "npm run storybook.run",
    "storybook.dev": "concurrently \"(cd ../core/ && npm start)\" \"npm run storybook.run\"",
    "storybook.fast": "node .storybook/performance-mode.js enable && npm run storybook.run",
    "storybook.restore": "node .storybook/performance-mode.js disable",
    "build-storybook": "npm run storybook.restore && storybook build",
    "build-storybook-gh": "npm run storybook.restore && BASE_PATH=/cpit-spectrum/ storybook build --output-dir storybook-static",
    "build-storybook-ci": "npm run storybook.restore && BASE_PATH=/stencil-storybook-boilerplate/ storybook build",
    "preview-storybook": "npx http-server storybook-static",
    "update": "npx npm-check-updates -u",
    "test-storybook": "test-storybook",
    "deploy-storybook": "npm run storybook.restore && storybook-to-ghpages",
    "deploy-storybook-fast": "npm run deploy-storybook && npm run storybook.fast"
  },
  "dependencies": {
    "@unops-itg-npm/cpit-spectrum": "^0.0.1-alpha.42",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.0.17",
    "@storybook/addon-docs": "^9.0.17",
    "@storybook/addon-links": "^9.0.17",
    "@storybook/storybook-deployer": "^2.8.16",
    "@storybook/web-components-vite": "^9.1.19",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "http-server": "^14.1.1",
    "mermaid": "^10.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^9.0.17",
    "vite": "^5.4.11"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.27.3"
  }
}
